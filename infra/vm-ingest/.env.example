VM_DATA_PRIVATE_IP=<vm-data-private-ip>
AUTH_TOKEN_ENDPOINT_URI=https://<vm-auth-private-ip>/oauth2/token
APP_TLS_DIR=/etc/smarttraffic/secrets/vm-ingest/client-tls
KAFKA_SENSOR_CLIENT_ID=traffic-sensor
KAFKA_SENSOR_CLIENT_SECRET=REPLACE_WITH_SECRET
KAFKA_SENSOR_OAUTH_SCOPE=traffic.readings.publish
KAFKA_TRUSTSTORE_PASSWORD=REPLACE_WITH_SECRET
AUTH_TRUSTSTORE_PASSWORD=REPLACE_WITH_SECRET
TRAFFIC_SENSOR_IDS=sensor-01,sensor-02
TRAFFIC_ZONE_IDS=zone-01,zone-02
TRAFFIC_MIN_VEHICLES=0
TRAFFIC_MAX_VEHICLES=100
TRAFFIC_INTERVAL_MS=1000
SIMULATOR_CPUS=0.5
SIMULATOR_MEMORY=768M
