VM_DATA_PRIVATE_IP=<vm-data-private-ip>
AUTH_ISSUER_URI=https://<edge-public-ip>
AUTH_TOKEN_ENDPOINT_URI=https://<vm-auth-private-ip>/oauth2/token
AUTH_TLS_TRUSTSTORE_PASSWORD=REPLACE_WITH_SECRET
APP_TLS_DIR=/etc/smarttraffic/secrets/vm-app/client-tls
DASHBOARD_OAUTH_CLIENT_ID=dashboard-bff
DASHBOARD_OAUTH_CLIENT_SECRET=REPLACE_WITH_SECRET
RABBITMQ_VHOST=smarttraffic
RABBITMQ_DASHBOARD_CLIENT_ID=dashboard-backend
RABBITMQ_DASHBOARD_CLIENT_SECRET=REPLACE_WITH_SECRET
RABBITMQ_DASHBOARD_OAUTH_SCOPE=smarttraffic-rabbitmq.read:smarttraffic/dashboard_updates_queue
RABBITMQ_DASHBOARD_QUEUE=dashboard_updates_queue
RABBITMQ_ALERTS_CLIENT_ID=alert-dispatcher
RABBITMQ_ALERTS_CLIENT_SECRET=REPLACE_WITH_SECRET
RABBITMQ_ALERTS_OAUTH_SCOPE=smarttraffic-rabbitmq.read:smarttraffic/alert_updates_queue smarttraffic-rabbitmq.read:smarttraffic/query_traffic_queue smarttraffic-rabbitmq.write:smarttraffic/query_answers/query-client-1 smarttraffic-rabbitmq.write:smarttraffic/query_answers/query-client-2
RABBITMQ_ALERT_QUEUE=alert_updates_queue
RABBITMQ_QUERY_EXCHANGE=query_requests
RABBITMQ_QUERY_QUEUE=query_traffic_queue
RABBITMQ_QUERY_ANSWERS_EXCHANGE=query_answers
RABBITMQ_QUERY_REPLY_ROUTES=query-client-1=query_reply_client_1,query-client-2=query_reply_client_2
RABBITMQ_QUERY_CLIENT_1_ID=query-client-1
RABBITMQ_QUERY_CLIENT_1_SECRET=REPLACE_WITH_SECRET
RABBITMQ_QUERY_CLIENT_1_SCOPE=smarttraffic-rabbitmq.write:smarttraffic/query_requests smarttraffic-rabbitmq.read:smarttraffic/query_reply_client_1
RABBITMQ_QUERY_REPLY_QUEUE_1=query_reply_client_1
RABBITMQ_QUERY_CLIENT_2_ID=query-client-2
RABBITMQ_QUERY_CLIENT_2_SECRET=REPLACE_WITH_SECRET
RABBITMQ_QUERY_CLIENT_2_SCOPE=smarttraffic-rabbitmq.write:smarttraffic/query_requests smarttraffic-rabbitmq.read:smarttraffic/query_reply_client_2
RABBITMQ_QUERY_REPLY_QUEUE_2=query_reply_client_2
QUERY_ZONE_IDS=zone-01,zone-02
QUERY_INTERVAL_SECONDS=10
QUERY_TIMEOUT_SECONDS=10
DASHBOARD_CPUS=0.5
DASHBOARD_MEMORY=768M
ALERTS_CPUS=0.5
ALERTS_MEMORY=768M
QUERY_CLIENT_CPUS=0.25
QUERY_CLIENT_MEMORY=384M
