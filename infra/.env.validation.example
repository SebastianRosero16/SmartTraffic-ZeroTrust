# Validation-only example — no real secrets, used only for docker compose config --quiet
# Never commit real values here.

# Shared
VM_DATA_PRIVATE_IP=10.0.1.10
AUTH_ISSUER_URI=https://auth.example.internal
AUTH_JWKS_URI=https://auth.example.internal/.well-known/jwks.json
AUTH_TOKEN_ENDPOINT_URI=https://auth.example.internal/oauth2/token
APP_TLS_DIR=./vm-auth

# Auth server
AUTH_TLS_KEYSTORE_PASSWORD=example
AUTH_TLS_DIR=./vm-auth
AUTH_SIGNING_KEYS_DIR=./vm-auth
AUTH_RUNTIME_CONFIG_DIR=./vm-auth
AUTH_SERVER_CPUS=0.5
AUTH_SERVER_MEMORY=256m

# Kafka
KAFKA_CLUSTER_ID=example-cluster-id
KAFKA_TLS_KEYSTORE_PASSWORD=example
KAFKA_TLS_KEY_PASSWORD=example
KAFKA_TLS_TRUSTSTORE_PASSWORD=example
KAFKA_TLS_DIR=./vm-auth
KAFKA_CLIENT_JAAS_FILE=./vm-auth/kafka-client-jaas.conf
KAFKA_SUPER_USERS=User:admin
KAFKA_CPUS=1.0
KAFKA_MEMORY=2g
KAFKA_HEAP_OPTS=-Xms512m -Xmx1536m
KAFKA_TLS_CLIENT_AUTH=none
KAFKA_OAUTH_AUDIENCE=kafka
KAFKA_BROKER_CLIENT_SECRET=example
KAFKA_BROKER_OAUTH_SCOPE=kafka
AUTH_TLS_TRUSTSTORE_PASSWORD=example

# RabbitMQ
RABBITMQ_TLS_DIR=./vm-auth
RABBITMQ_CPUS=0.5
RABBITMQ_MEMORY=512m
RABBITMQ_VHOST=smarttraffic

# PostgreSQL
POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=example
POSTGRES_APP_USER=app
POSTGRES_APP_PASSWORD=example
POSTGRES_DB=smarttraffic
POSTGRES_CPUS=0.5
POSTGRES_MEMORY=512m

# Simulator
KAFKA_SENSOR_CLIENT_ID=traffic-sensor
KAFKA_SENSOR_CLIENT_SECRET=example
KAFKA_SENSOR_OAUTH_SCOPE=kafka:write
KAFKA_TRUSTSTORE_PASSWORD=example
AUTH_TRUSTSTORE_PASSWORD=example
TRAFFIC_SENSOR_IDS=sensor-1,sensor-2
TRAFFIC_ZONE_IDS=zone-01,zone-02
TRAFFIC_MIN_VEHICLES=0
TRAFFIC_MAX_VEHICLES=100
TRAFFIC_INTERVAL_MS=1000
SIMULATOR_CPUS=0.25
SIMULATOR_MEMORY=128m
KAFKA_TRAFFIC_READINGS_TOPIC=traffic_readings

# Processor
KAFKA_PROCESSOR_CLIENT_ID=traffic-processor-kafka
KAFKA_PROCESSOR_CLIENT_SECRET=example
KAFKA_PROCESSOR_OAUTH_SCOPE=kafka:read
KAFKA_STREAMS_APPLICATION_ID=traffic-density-processor
RABBITMQ_PROCESSOR_CLIENT_ID=traffic-processor
RABBITMQ_PROCESSOR_CLIENT_SECRET=example
RABBITMQ_PROCESSOR_OAUTH_SCOPE=rabbitmq:write
RABBITMQ_UPDATES_EXCHANGE=traffic_updates
TRAFFIC_WINDOW_SECONDS=60
TRAFFIC_WINDOW_GRACE_SECONDS=10
TRAFFIC_DENSITY_STRATEGY=average
TRAFFIC_MODERATE_THRESHOLD=50
TRAFFIC_CONGESTED_THRESHOLD=80
PROCESSOR_CPUS=0.5
PROCESSOR_MEMORY=512m

# Archiver
KAFKA_ARCHIVER_CLIENT_ID=traffic-archiver
KAFKA_ARCHIVER_CLIENT_SECRET=example
KAFKA_ARCHIVER_OAUTH_SCOPE=kafka:read
ARCHIVER_CPUS=0.25
ARCHIVER_MEMORY=256m

# Dashboard backend
RABBITMQ_DASHBOARD_CLIENT_ID=dashboard
RABBITMQ_DASHBOARD_CLIENT_SECRET=example
RABBITMQ_DASHBOARD_OAUTH_SCOPE=rabbitmq:read
RABBITMQ_DASHBOARD_QUEUE=dashboard_updates_queue
DASHBOARD_CPUS=0.5
DASHBOARD_MEMORY=256m

# Alert dispatcher
RABBITMQ_ALERTS_CLIENT_ID=alert-dispatcher
RABBITMQ_ALERTS_CLIENT_SECRET=example
RABBITMQ_ALERTS_OAUTH_SCOPE=rabbitmq:read
RABBITMQ_ALERT_QUEUE=alert_updates_queue
RABBITMQ_QUERY_QUEUE=query_traffic_queue
RABBITMQ_QUERY_ANSWERS_EXCHANGE=query_answers
RABBITMQ_QUERY_REPLY_ROUTES=query-client-1=query_reply_client_1,query-client-2=query_reply_client_2
ALERTS_CPUS=0.25
ALERTS_MEMORY=256m

# Query clients
RABBITMQ_QUERY_CLIENT_1_ID=query-client-1
RABBITMQ_QUERY_CLIENT_1_SECRET=example
RABBITMQ_QUERY_CLIENT_1_SCOPE=rabbitmq:read
RABBITMQ_QUERY_REPLY_QUEUE_1=query_reply_client_1
RABBITMQ_QUERY_CLIENT_2_ID=query-client-2
RABBITMQ_QUERY_CLIENT_2_SECRET=example
RABBITMQ_QUERY_CLIENT_2_SCOPE=rabbitmq:read
RABBITMQ_QUERY_REPLY_QUEUE_2=query_reply_client_2
RABBITMQ_QUERY_EXCHANGE=query_requests
QUERY_ZONE_IDS=zone-01,zone-02
QUERY_INTERVAL_SECONDS=10
QUERY_TIMEOUT_SECONDS=10
QUERY_CLIENT_CPUS=0.25
QUERY_CLIENT_MEMORY=128m
