VM_DATA_PRIVATE_IP=<vm-data-private-ip>
AUTH_TOKEN_ENDPOINT_URI=https://<vm-auth-private-ip>/oauth2/token
APP_TLS_DIR=/etc/smarttraffic/secrets/vm-core/client-tls
KAFKA_TRAFFIC_READINGS_TOPIC=traffic_readings
KAFKA_STREAMS_APPLICATION_ID=traffic-density-processor-v3
KAFKA_PROCESSOR_CLIENT_ID=traffic-processor-kafka
KAFKA_PROCESSOR_CLIENT_SECRET=REPLACE_WITH_SECRET
KAFKA_PROCESSOR_OAUTH_SCOPE=traffic.readings.consume
KAFKA_ARCHIVER_CLIENT_ID=traffic-archiver
KAFKA_ARCHIVER_CLIENT_SECRET=REPLACE_WITH_SECRET
KAFKA_ARCHIVER_OAUTH_SCOPE=traffic.readings.archive
KAFKA_TRUSTSTORE_PASSWORD=REPLACE_WITH_SECRET
AUTH_TRUSTSTORE_PASSWORD=REPLACE_WITH_SECRET
RABBITMQ_VHOST=smarttraffic
RABBITMQ_UPDATES_EXCHANGE=traffic_updates
RABBITMQ_PROCESSOR_CLIENT_ID=traffic-processor-rabbit
RABBITMQ_PROCESSOR_CLIENT_SECRET=REPLACE_WITH_SECRET
RABBITMQ_PROCESSOR_OAUTH_SCOPE=smarttraffic-rabbitmq.write:smarttraffic/traffic_updates
POSTGRES_DB=smarttraffic
POSTGRES_APP_USER=smarttraffic_app
POSTGRES_APP_PASSWORD=REPLACE_WITH_SECRET
TRAFFIC_WINDOW_SECONDS=60
TRAFFIC_WINDOW_GRACE_SECONDS=10
TRAFFIC_DENSITY_STRATEGY=average
TRAFFIC_MODERATE_THRESHOLD=30
TRAFFIC_CONGESTED_THRESHOLD=70
PROCESSOR_CPUS=1.0
PROCESSOR_MEMORY=1536M
ARCHIVER_CPUS=0.5
ARCHIVER_MEMORY=1024M
