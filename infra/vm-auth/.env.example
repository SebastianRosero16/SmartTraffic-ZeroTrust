AUTH_ISSUER_URI=https://<edge-public-ip>
AUTH_TLS_DIR=/etc/smarttraffic/secrets/vm-auth/auth-tls
AUTH_SIGNING_KEYS_DIR=/etc/smarttraffic/secrets/vm-auth/auth-signing
AUTH_RUNTIME_CONFIG_DIR=/etc/smarttraffic/secrets/vm-auth/auth-config
AUTH_DB_TLS_CA_DIR=/etc/smarttraffic/secrets/vm-auth/postgres-ca
AUTH_DB_URL=jdbc:postgresql://<vm-data-private-ip>:5432/smarttraffic?sslmode=verify-full&sslrootcert=/run/auth/db-tls/postgres-ca.pem
AUTH_DB_USER=dashboard_auth_runtime
AUTH_DB_PASSWORD=REPLACE_WITH_SECRET
AUTH_DB_MIGRATOR_USER=dashboard_auth_migrator
AUTH_DB_MIGRATOR_PASSWORD=REPLACE_WITH_SECRET
AUTH_TLS_KEYSTORE_PASSWORD=REPLACE_WITH_SECRET
DASHBOARD_OAUTH_CLIENT_ID=dashboard-bff
DASHBOARD_OAUTH_CLIENT_SECRET=REPLACE_WITH_SECRET
DASHBOARD_OAUTH_REDIRECT_URI=https://<edge-public-ip>/login/oauth2/code/dashboard
DASHBOARD_AUTH_USERNAME=dashboard-viewer
AUTH_SERVER_CPUS=0.5
AUTH_SERVER_MEMORY=768M
