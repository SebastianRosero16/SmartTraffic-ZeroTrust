# Copy to .env and fill in values approved for the local test.
# Empty required values intentionally prevent an insecure/default startup.
KAFKA_CLUSTER_ID=
CLIENT_PORT=
CONTROLLER_PORT=
OAUTH_JWKS_ENDPOINT=
OAUTH_ISSUER_URI=
OAUTH_KAFKA_AUDIENCE=
KAFKA_SUPER_USERS=

# Path to externally-created TLS material; no certificates or passwords belong
# in this repository. Credential files are mounted read-only into the broker.
TLS_SECRETS_DIR=./secrets
KAFKA_CLIENT_JAAS_FILE=
TLS_KEYSTORE_FILENAME=
TLS_KEYSTORE_CREDENTIALS_FILE=
TLS_KEY_CREDENTIALS_FILE=
TLS_TRUSTSTORE_FILENAME=
TLS_TRUSTSTORE_CREDENTIALS_FILE=
TLS_KEYSTORE_TYPE=
TLS_TRUSTSTORE_TYPE=
TLS_CLIENT_AUTH=
