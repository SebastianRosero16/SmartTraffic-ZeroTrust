VM_DATA_PRIVATE_IP=<vm-data-private-ip>
AUTH_ISSUER_URI=https://<edge-public-ip>
AUTH_TOKEN_ENDPOINT_URI=https://<vm-auth-private-ip>/oauth2/token
AUTH_JWKS_URI=https://<vm-auth-private-ip>/oauth2/jwks
AUTH_TLS_TRUSTSTORE_PASSWORD=REPLACE_WITH_SECRET
KAFKA_CLUSTER_ID=REPLACE_WITH_GENERATED_CLUSTER_ID
KAFKA_OAUTH_AUDIENCE=urn:smarttraffic:kafka
KAFKA_BROKER_CLIENT_SECRET=REPLACE_WITH_SECRET
KAFKA_BROKER_OAUTH_SCOPE=kafka.cluster.admin
KAFKA_SUPER_USERS=User:urn:smarttraffic:kafka
KAFKA_TLS_CLIENT_AUTH=none
KAFKA_TLS_DIR=/etc/smarttraffic/secrets/vm-data/kafka-tls
KAFKA_TLS_KEYSTORE_PASSWORD=REPLACE_WITH_SECRET
KAFKA_TLS_KEY_PASSWORD=REPLACE_WITH_SECRET
KAFKA_TLS_TRUSTSTORE_PASSWORD=REPLACE_WITH_SECRET
KAFKA_CLIENT_JAAS_FILE=/etc/smarttraffic/secrets/vm-data/kafka-client-jaas.conf
# These names must match smarttraffic_data_volumes in the Ansible inventory.
KAFKA_DATA_VOLUME_NAME=smarttraffic-kafka-data
KAFKA_CPUS=1.0
KAFKA_MEMORY=3G
RABBITMQ_RESOURCE_SERVER_ID=smarttraffic-rabbitmq
RABBITMQ_TLS_DIR=/etc/smarttraffic/secrets/vm-data/rabbitmq-tls
RABBITMQ_DATA_VOLUME_NAME=smarttraffic-rabbitmq-data
RABBITMQ_CPUS=0.5
RABBITMQ_MEMORY=1G
POSTGRES_DB=smarttraffic
POSTGRES_ADMIN_USER=smarttraffic_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_SECRET
POSTGRES_APP_USER=smarttraffic_app
POSTGRES_APP_PASSWORD=REPLACE_WITH_SECRET
POSTGRES_TLS_DIR=/etc/smarttraffic/secrets/vm-data/postgres-tls
POSTGRES_DATA_VOLUME_NAME=smarttraffic-postgres-data
AUTH_DB_USER=dashboard_auth_runtime
AUTH_DB_PASSWORD=REPLACE_WITH_SECRET
AUTH_DB_MIGRATOR_USER=dashboard_auth_migrator
AUTH_DB_MIGRATOR_PASSWORD=REPLACE_WITH_SECRET
POSTGRES_CPUS=0.25
POSTGRES_MEMORY=1G
