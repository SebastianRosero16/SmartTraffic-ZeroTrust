# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven build output
target/

# Local authentication secrets
services/auth-server/.secrets/
services/auth-server/*.pem
services/auth-server/**/*.pem
services/auth-server/*.key
services/auth-server/**/*.key
services/auth-server/*.p12
services/auth-server/**/*.p12
services/auth-server/*.pfx
services/auth-server/**/*.pfx
services/auth-server/*.jks
services/auth-server/**/*.jks
services/auth-server/.env
services/auth-server/**/.env

# Local vm-data OAuth/TLS configuration and persisted broker data
infra/vm-data/.env
infra/vm-data/secrets/
infra/vm-data/data/

# Local deployment configuration and mounted secrets
infra/**/.env
infra/**/secrets/
infra/**/data/
infra/deployment/local-secrets/
infra/deployment/ansible/inventory/hosts.yml
infra/deployment/ansible/group_vars/all.yml

# Terraform state, plans, and local credentials
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
*.tfvars.save*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
